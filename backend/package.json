{
  "name": "eduflow-backend",
  "version": "1.0.0",
  "description": "EduFlow Backend API",
  "main": "dist/index.js",
  "scripts": {
    "test:rbac": "jest tests/integration/rbac.test.ts --detectOpenHandles",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:coverage": "NODE_ENV=test jest --coverage --detectOpenHandles --forceExit",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "generate": "prisma generate",
    "test:auth": "./scripts/test-auth.sh",
    "test:auth:port": "./scripts/test-auth.sh 3000",
    "test:watch": "jest --watch",
    "test:quiz": "./scripts/test-quiz.sh",
    "test:all": "pnpm run test:auth && pnpm run test:quiz"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "4.17.21",
    "@types/node": "^26.1.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3"
  }
}
