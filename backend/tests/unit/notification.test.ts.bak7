import { NotificationService } from '../../src/services/NotificationService';
import { NotificationStatus } from '@prisma/client';

// Mock repository dengan factory
jest.mock('../../src/repositories/NotificationRepository', () => {
  const mockRepo = {
    create: jest.fn(),
    getById: jest.fn(),
    getByUser: jest.fn(),
    getUnreadCount: jest.fn(),
    markAsRead: jest.fn(),
    markAllAsRead: jest.fn(),
    delete: jest.fn(),
    getTotalCount: jest.fn(),
  };
  return {
    NotificationRepository: jest.fn().mockImplementation(() => mockRepo),
    __mockRepo: mockRepo,
  };
});

const { __mockRepo } = jest.requireMock('../../src/repositories/NotificationRepository');

describe('NotificationService', () => {
  let service: NotificationService;
  let mockRepo: any;

  beforeEach(() => {
    jest.clearAllMocks();
    service = new NotificationService();
    mockRepo = __mockRepo;
    (service as any).notificationRepo = mockRepo;
  });

  test('triggerSubmissionGraded creates notification', async () => {
    const submissionId = 'sub-123';
    const studentId = 'user-123';
    const score = 85;
    const quizTitle = 'Test Quiz';

    const mockNotification = {
      id: 'notif-123',
      user_id: studentId,
      type: 'submission_graded',
      title: 'Quiz Graded',
      message: `Your submission for "${quizTitle}" has been graded: ${score}%`,
      data: { submission_id: submissionId, score },
      status: NotificationStatus.sent,
      read_at: null,
      created_at: new Date(),
    };

    mockRepo.create.mockResolvedValue(mockNotification);

    const result = await service.triggerSubmissionGraded(submissionId, studentId, score, quizTitle);

    expect(result).toBeDefined();
    expect(mockRepo.create).toHaveBeenCalledWith({
      user_id: studentId,
      type: 'submission_graded',
      title: 'Quiz Graded',
      message: `Your submission for "${quizTitle}" has been graded: ${score}%`,
      data: { submission_id: submissionId, score },
      status: NotificationStatus.sent,
    });
    expect(result).toEqual(mockNotification);
  });

  test('markAsRead sets read_at timestamp', async () => {
    const notificationId = 'notif-123';
    const userId = 'user-123';

    const mockNotification = {
      id: notificationId,
      user_id: userId,
      type: 'submission_graded',
      title: 'Test',
      message: 'Test message',
      data: {},
      status: NotificationStatus.sent,
      read_at: null,
      created_at: new Date(),
    };

    const updatedNotification = {
      ...mockNotification,
      read_at: new Date(),
    };

    mockRepo.getById.mockResolvedValue(mockNotification);
    mockRepo.markAsRead.mockResolvedValue(updatedNotification);

    const result = await service.markAsRead(notificationId, userId);

    expect(result).toBeDefined();
    expect(mockRepo.getById).toHaveBeenCalledWith(notificationId);
    expect(mockRepo.markAsRead).toHaveBeenCalledWith(notificationId, userId);
    expect(result.read_at).toBeDefined();
  });

  test('markAsRead throws error if notification not found', async () => {
    const notificationId = 'notif-123';
    const userId = 'user-123';

    mockRepo.getById.mockResolvedValue(null);

    await expect(service.markAsRead(notificationId, userId)).rejects.toThrow('Notification not found');
    expect(mockRepo.markAsRead).not.toHaveBeenCalled();
  });

  test('markAsRead throws error if unauthorized', async () => {
    const notificationId = 'notif-123';
    const userId = 'user-123';

    const mockNotification = {
      id: notificationId,
      user_id: 'other-user',
      type: 'submission_graded',
      title: 'Test',
      message: 'Test',
      data: {},
      status: NotificationStatus.sent,
      read_at: null,
      created_at: new Date(),
    };

    mockRepo.getById.mockResolvedValue(mockNotification);

    await expect(service.markAsRead(notificationId, userId)).rejects.toThrow('Unauthorized');
    expect(mockRepo.markAsRead).not.toHaveBeenCalled();
  });

  test('deleteNotification deletes notification', async () => {
    const notificationId = 'notif-123';
    const userId = 'user-123';

    const mockNotification = {
      id: notificationId,
      user_id: userId,
      type: 'submission_graded',
      title: 'Test',
      message: 'Test',
      data: {},
      status: NotificationStatus.sent,
      read_at: null,
      created_at: new Date(),
    };

    mockRepo.getById.mockResolvedValue(mockNotification);
    mockRepo.delete.mockResolvedValue(undefined);

    await service.deleteNotification(notificationId, userId);

    expect(mockRepo.getById).toHaveBeenCalledWith(notificationId);
    expect(mockRepo.delete).toHaveBeenCalledWith(notificationId, userId);
  });

  test('deleteNotification throws error if not found', async () => {
    const notificationId = 'notif-123';
    const userId = 'user-123';

    mockRepo.getById.mockResolvedValue(null);

    await expect(service.deleteNotification(notificationId, userId)).rejects.toThrow('Notification not found');
    expect(mockRepo.delete).not.toHaveBeenCalled();
  });

  test('markAllAsRead marks all notifications as read', async () => {
    const userId = 'user-123';
    const expectedCount = 5;

    mockRepo.markAllAsRead.mockResolvedValue({ count: expectedCount });

    const result = await service.markAllAsRead(userId);

    expect(result).toBeDefined();
    expect(result.count).toBe(expectedCount);
    expect(mockRepo.markAllAsRead).toHaveBeenCalledWith(userId);
  });

  test('getUserNotifications returns formatted result', async () => {
    const userId = 'user-123';
    const notifications = [
      {
        id: 'notif-1',
        user_id: userId,
        type: 'submission_graded',
        title: 'Quiz Graded',
        message: 'Your score: 85%',
        data: { score: 85 },
        status: NotificationStatus.sent,
        read_at: null,
        created_at: new Date(),
      },
      {
        id: 'notif-2',
        user_id: userId,
        type: 'submission_graded',
        title: 'Quiz Graded',
        message: 'Your score: 90%',
        data: { score: 90 },
        status: NotificationStatus.read,
        read_at: new Date(),
        created_at: new Date(),
      },
    ];

    mockRepo.getByUser.mockResolvedValue(notifications);
    mockRepo.getUnreadCount.mockResolvedValue(1);
    mockRepo.getTotalCount.mockResolvedValue(2);

    // ✅ Service signature: userId, unreadOnly, limit, offset (PARAMETER TERPISAH)
    const result = await service.getUserNotifications(userId, false, 10, 0);

    expect(result).toBeDefined();
    expect(result.total).toBe(2);
    expect(result.unread_count).toBe(1);
    expect(Array.isArray(result.notifications)).toBe(true);
    expect(result.notifications.length).toBe(2);
    
    // Service memanggil getByUser dengan { unread, limit, offset }
    expect(mockRepo.getByUser).toHaveBeenCalledWith(userId, { 
      unread: false, 
      limit: 10, 
      offset: 0 
    });
    expect(mockRepo.getUnreadCount).toHaveBeenCalledWith(userId);
    expect(mockRepo.getTotalCount).toHaveBeenCalledWith(userId);
  });
});
