// ==============================================
// EDUFLOW - PRISMA SCHEMA (FASE 3)
// ==============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================
// ENUMS (FASE 1)
// ==============================================

enum UserRole {
  admin
  instructor
  student
}

enum AccountStatus {
  active
  suspended
  archived
}

enum OrgStatus {
  active
  inactive
  archived
}

// ==============================================
// ENUMS (FASE 2)
// ==============================================

enum QuizType {
  standard
  ielts_simulation
  timed_exam
}

enum QuizStatus {
  draft
  published
  archived
}

enum QuestionType {
  mcq
  true_false
  short_answer
  essay
}

enum QuestionStatus {
  active
  deprecated
  inactive
}

enum DifficultyLevel {
  easy
  medium
  hard
}

enum IELTSSection {
  Listening
  Reading
  Writing
  Speaking
}

// ==============================================
// ENUMS (FASE 3)
// ==============================================

enum SubmissionStatus {
  in_progress
  submitted
  graded
}

enum GradingStatus {
  pending_auto_grade
  auto_graded
  pending_manual_review
  manual_review_complete
}

enum AuditOperation {
  INSERT
  UPDATE
  DELETE
}

enum ActorType {
  user
  system
  admin
}

// ==============================================
// MODELS (FASE 1)
// ==============================================

model Organization {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  logo_url    String?  @db.VarChar(500)
  
  admin_id    String
  admin       User     @relation("org_admin", fields: [admin_id], references: [id], onDelete: Restrict)
  
  status      OrgStatus @default(active)
  
  users       User[]   @relation("org_users")
  quizzes     Quiz[]
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?
  
  @@index([slug])
  @@index([admin_id])
  @@index([deleted_at])
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique @db.VarChar(255)
  password_hash     String        @db.VarChar(255)
  first_name        String        @db.VarChar(100)
  last_name         String        @db.VarChar(100)
  
  role              UserRole      @default(student)
  organization_id   String?
  organization      Organization? @relation("org_users", fields: [organization_id], references: [id], onDelete: SetNull)
  
  bio               String?       @db.Text
  avatar_url        String?       @db.VarChar(500)
  
  status            AccountStatus @default(active)
  email_verified    Boolean       @default(false)
  email_verified_at DateTime?
  
  last_login_at     DateTime?
  
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
  
  // Relations for future tables
  admin_orgs        Organization[] @relation("org_admin")
  submissions       Submission[]   @relation("StudentSubmissions")
  audit_logs        AuditLog[]
  instructor_quizzes Quiz[]        @relation("instructor_quizzes")
  quiz_versions     QuizVersion[]
  
  @@index([email])
  @@index([role])
  @@index([organization_id])
  @@index([deleted_at])
}

// ==============================================
// MODELS (FASE 2)
// ==============================================

model Quiz {
  id                String    @id @default(cuid())
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  
  instructor_id     String
  instructor        User      @relation("instructor_quizzes", fields: [instructor_id], references: [id], onDelete: Cascade)
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  
  quiz_type         QuizType  @default(standard)
  total_questions   Int       @default(0)
  passing_score     Float     @default(60.00)
  duration_minutes  Int       @default(60)
  show_correct_answers Boolean @default(true)
  allow_review      Boolean   @default(true)
  max_attempts      Int       @default(1)
  randomize_questions Boolean @default(false)
  randomize_options Boolean   @default(false)
  
  status            QuizStatus @default(draft)
  is_public         Boolean   @default(false)
  
  current_version   Int       @default(1)
  total_attempts    Int       @default(0)
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  published_at      DateTime?
  deleted_at        DateTime?
  
  questions         Question[]
  quiz_versions     QuizVersion[]
  submissions       Submission[]
  
  @@index([instructor_id])
  @@index([organization_id])
  @@index([status])
  @@index([created_at])
  @@index([deleted_at])
}

model QuizVersion {
  id                String    @id @default(cuid())
  quiz_id           String
  quiz              Quiz      @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  version_number    Int
  
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  total_questions   Int
  passing_score     Float
  duration_minutes  Int
  quiz_type         QuizType
  
  changed_by        String
  changed_by_user   User      @relation(fields: [changed_by], references: [id])
  change_reason     String?   @db.Text
  created_at        DateTime  @default(now())
  
  @@unique([quiz_id, version_number])
  @@index([quiz_id])
  @@index([changed_by])
}

model Question {
  id                String    @id @default(cuid())
  quiz_id           String
  quiz              Quiz      @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  
  question_text     String    @db.Text
  question_type     QuestionType
  
  difficulty_level  DifficultyLevel @default(medium)
  points            Int       @default(1)
  order_in_quiz     Int
  ielts_section     IELTSSection?
  explanation       String?   @db.Text
  
  correct_answer    String?   @db.Text
  fuzzy_threshold   Float?
  manual_review     Boolean   @default(false)
  
  status            QuestionStatus @default(active)
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?
  
  options           Option[]
  answers           Answer[]
  
  @@unique([quiz_id, order_in_quiz])
  @@index([quiz_id])
  @@index([question_type])
  @@index([ielts_section])
}

model Option {
  id                String    @id @default(cuid())
  question_id       String
  question          Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)
  
  option_text       String    @db.Text
  is_correct        Boolean   @default(false)
  order_in_question Int
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  answers           Answer[]
  
  @@unique([question_id, order_in_question])
  @@index([question_id])
}

// ==============================================
// MODELS (FASE 3)
// ==============================================

model Submission {
  id                      String            @id @default(uuid())
  quiz_id                 String            @db.Uuid
  quiz                    Quiz              @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  student_id              String            @db.Uuid
  student                 User              @relation("StudentSubmissions", fields: [student_id], references: [id], onDelete: Cascade)
  
  status                  SubmissionStatus  @default(in_progress)
  grading_status          GradingStatus     @default(pending_auto_grade)
  attempt_number          Int               @default(1)
  
  total_points_earned     Int               @default(0)
  total_points_max        Int               @default(0)
  score_percentage        Float             @default(0)
  is_passed               Boolean?
  
  time_spent_milliseconds Int               @default(0)
  
  created_at              DateTime          @default(now())
  submitted_at            DateTime?
  graded_at               DateTime?
  updated_at              DateTime          @updatedAt
  
  answers                 Answer[]
  
  @@unique([quiz_id, student_id, attempt_number])
  @@index([student_id])
  @@index([quiz_id])
  @@index([status])
}

model Answer {
  id                      String            @id @default(uuid())
  submission_id           String            @db.Uuid
  submission              Submission        @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question_id             String            @db.Uuid
  question                Question          @relation(fields: [question_id], references: [id], onDelete: Cascade)
  
  student_answer          String?
  is_correct              Boolean?
  points_earned           Int               @default(0)
  similarity_score        Float?
  
  time_spent_seconds      Int               @default(0)
  
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  
  @@unique([submission_id, question_id])
  @@index([submission_id])
  @@index([question_id])
}

model AuditLog {
  id                      String            @id @default(uuid())
  operation               AuditOperation
  table_name              String
  record_id               String            @db.Uuid
  
  actor_id                String            @db.Uuid
  actor                   User              @relation(fields: [actor_id], references: [id], onDelete: Cascade)
  actor_type              ActorType
  
  old_values              Json?
  new_values              Json?
  
  created_at              DateTime          @default(now())
  
  @@index([actor_id])
  @@index([table_name])
  @@index([record_id])
  @@index([created_at])
}
