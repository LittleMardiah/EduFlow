import { Request, Response, NextFunction } from 'express';
import jwt from 'jsonwebtoken';
import { config } from '../config/env';
import { logger } from '../utils/logger';
import prisma from '../config/prisma'; // Pastikan path ini sesuai dengan file prisma client Anda

declare global {
  namespace Express {
    interface Request {
      user?: {
        userId: string;
        email: string;
        role: string;
      };
    }
  }
}

export function authMiddleware() {
  return async (req: Request, res: Response, next: NextFunction) => {
    try {
      // Skip auth untuk health check atau endpoint publik
      if (req.path === '/health' || req.path === '/api/v1/health') {
        return next();
      }

      const authHeader = req.headers.authorization;
      if (!authHeader || !authHeader.startsWith('Bearer ')) {
        return res.status(401).json({ error: 'Unauthorized: No token provided' });
      }

      const token = authHeader.split(' ')[1];
      
      let decoded: any;
      try {
        decoded = jwt.verify(token, config.jwtSecret);
      } catch (err) {
        return res.status(401).json({ error: 'Unauthorized: Invalid token' });
      }

      // Attach user to request
      req.user = {
        userId: decoded.userId || decoded.sub,
        email: decoded.email,
        role: decoded.role,
      };

      // ==========================================
      // KRITIKAL: SET SESSION VARIABLE UNTUK RLS
      // ==========================================
      // Ini memberi tahu database siapa user yang sedang login
      // sehingga fungsi current_user_id() dan current_user_role() bisa berfungsi.
      try {
        await prisma.$executeRaw`SET app.current_user_id = ${req.user.userId};`;
        await prisma.$executeRaw`SET app.current_user_role = ${req.user.role};`;
        logger.debug(`RLS session set: user_id=${req.user.userId}, role=${req.user.role}`);
      } catch (err) {
        logger.error('Gagal mengatur session variable untuk RLS:', err);
        // Jangan block request, tapi log error
      }

      next();
    } catch (error) {
      logger.error('Auth middleware error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  };
}
