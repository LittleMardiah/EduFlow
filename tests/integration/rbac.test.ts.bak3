import "../setup";
import request from 'supertest';
import app from '../../src/index';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

// Helper: Login dan dapatkan token
async function loginAndGetToken(email: string, password: string = 'SecurePass123!') {
  const res = await request(app)
    .post('/api/v1/auth/login')
    .send({ email, password });
  return res.body.data?.token || res.body.token;
}

// Helper: Buat user test
async function createTestUser(role: 'student' | 'instructor' | 'admin') {
  const email = `test_${role}_${Date.now()}@example.com`;
  const password = 'SecurePass123!';
  const registerRes = await request(app)
    .post('/api/v1/auth/register')
    .send({
      email,
      password,
      first_name: 'Test',
      last_name: role,
      role,
    });
  console.log('📝 Register response:', registerRes.status, registerRes.body);
  
  // Update role di DB (karena register hanya bisa student)
  await prisma.user.update({
    where: { email },
    data: { role },
  });
  return { email, password };
}

describe('RBAC Integration Tests (FASE 2)', () => {
  let studentToken: string;
  let instructorAToken: string;
  let instructorBToken: string;
  let adminToken: string;
  let quizId: string;

  beforeAll(async () => {
    // Setup: Buat 2 instructor, 1 student, 1 admin
    const student = await createTestUser('student');
    studentToken = await loginAndGetToken(student.email, student.password);

    const instructorA = await createTestUser('instructor');
    instructorAToken = await loginAndGetToken(instructorA.email, instructorA.password);

    const instructorB = await createTestUser('instructor');
    instructorBToken = await loginAndGetToken(instructorB.email, instructorB.password);

    const admin = await createTestUser('admin');
    adminToken = await loginAndGetToken(admin.email, admin.password);

    // Buat 1 quiz milik Instructor A
    const createRes = await request(app)
      .post('/api/v1/quizzes')
      .set('Authorization', `Bearer ${instructorAToken}`)
      .send({
        title: 'Quiz Instructor A',
        description: 'For RBAC test',
        quiz_type: 'standard',
        passing_score: 70,
        duration_minutes: 30,
      });
    
    // LOGGING: Lihat response sebenarnya
    console.log('📝 Create quiz response:', createRes.status, createRes.body);
    
    // Coba ambil dari berbagai kemungkinan struktur
    quizId = createRes.body.data?.id || createRes.body.id;
    if (!quizId) {
      console.error('❌ Gagal membuat quiz. Response:', JSON.stringify(createRes.body, null, 2));
      throw new Error('Gagal membuat quiz: quizId tidak ditemukan di response');
    }
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  // =============================================
  // TEST 1: STUDENT CANNOT CREATE QUIZ
  // =============================================
  test('Student POST /quizzes -> 403 Forbidden', async () => {
    const res = await request(app)
      .post('/api/v1/quizzes')
      .set('Authorization', `Bearer ${studentToken}`)
      .send({
        title: 'Hack Quiz',
        description: 'Should fail',
        quiz_type: 'standard',
        passing_score: 50,
        duration_minutes: 10,
      });
    console.log('📝 Student create quiz:', res.status, res.body);
    expect(res.status).toBe(403);
    expect(res.body.error).toMatch(/Forbidden/i);
  });

  // =============================================
  // TEST 2: INSTRUCTOR A CANNOT EDIT INSTRUCTOR B's QUIZ
  // =============================================
  test('Instructor B PATCH /quizzes/:id (milik A) -> 403 Forbidden', async () => {
    const res = await request(app)
      .patch(`/api/v1/quizzes/${quizId}`)
      .set('Authorization', `Bearer ${instructorBToken}`)
      .send({ title: 'Hacked by B' });
    console.log('📝 Instructor B edit quiz A:', res.status, res.body);
    expect(res.status).toBe(403);
    expect(res.body.error).toMatch(/Forbidden|own this resource/i);
  });

  // =============================================
  // TEST 3: ADMIN CAN EDIT ANY QUIZ
  // =============================================
  test('Admin PATCH /quizzes/:id -> 200 OK', async () => {
    const res = await request(app)
      .patch(`/api/v1/quizzes/${quizId}`)
      .set('Authorization', `Bearer ${adminToken}`)
      .send({ title: 'Edited by Admin' });
    console.log('📝 Admin edit quiz:', res.status, res.body);
    expect(res.status).toBe(200);
    expect(res.body.data?.title || res.body.title).toBe('Edited by Admin');
  });

  // =============================================
  // TEST 4: INSTRUCTOR A CAN DELETE OWN QUIZ (SOFT DELETE)
  // =============================================
  test('Instructor A DELETE /quizzes/:id (milik sendiri) -> 204 No Content', async () => {
    const res = await request(app)
      .delete(`/api/v1/quizzes/${quizId}`)
      .set('Authorization', `Bearer ${instructorAToken}`);
    console.log('📝 Instructor A delete own quiz:', res.status);
    expect(res.status).toBe(204);
  });

  // =============================================
  // TEST 5: STUDENT CAN ONLY SEE PUBLISHED QUIZZES
  // =============================================
  test('Student GET /quizzes -> only sees published (or empty)', async () => {
    // Buat quiz published dulu oleh admin
    const pubRes = await request(app)
      .post('/api/v1/quizzes')
      .set('Authorization', `Bearer ${adminToken}`)
      .send({
        title: 'Public Quiz for Student',
        quiz_type: 'standard',
        passing_score: 50,
        duration_minutes: 10,
      });
    console.log('📝 Create public quiz:', pubRes.status, pubRes.body);
    const pubId = pubRes.body.data?.id || pubRes.body.id;
    await request(app)
      .patch(`/api/v1/quizzes/${pubId}/publish`)
      .set('Authorization', `Bearer ${adminToken}`);

    const res = await request(app)
      .get('/api/v1/quizzes')
      .set('Authorization', `Bearer ${studentToken}`);
    console.log('📝 Student GET quizzes:', res.status, 'body type:', typeof res.body);
    
    // Ambil array dari response (bisa di data.quizzes, data, atau langsung)
    let quizzes = res.body.data?.quizzes || res.body.data || res.body.quizzes || [];
    if (!Array.isArray(quizzes)) {
      quizzes = [];
    }
    const published = quizzes.filter((q: any) => q.status === 'published');
    const drafts = quizzes.filter((q: any) => q.status === 'draft' || q.status === 'archived');
    expect(drafts.length).toBe(0);
  });
});
